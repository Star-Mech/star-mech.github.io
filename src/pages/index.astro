---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContextPanels from '../components/ContextPanels.astro';
import { profile, links, practiceAreas, work, workBySlug } from '../data/site';
---

<Base>
  <!-- ===================================================================
       Hero
  =================================================================== -->
  <section class="mx-auto max-w-5xl px-5 pt-20 pb-16 sm:pt-28">
    <p class="label">
      {profile.role} · {profile.location} · {profile.remote}
    </p>

    <h1 class="mt-5 max-w-3xl text-[length:var(--text-hero)] font-semibold leading-[1.05]">
      {profile.positioning}
    </h1>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-muted">
      {profile.stance}
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#work"
        class="rounded bg-signal px-4 py-2.5 text-sm font-medium text-canvas transition-opacity hover:opacity-90"
      >
        See the work
      </a>
      <a
        href={links.paper}
        target="_blank"
        rel="noopener"
        class="rounded border border-line-bright px-4 py-2.5 text-sm text-ink transition-colors hover:border-signal-dim hover:text-signal"
      >
        Read the paper
      </a>
      <a
        href={links.cv}
        class="rounded border border-line px-4 py-2.5 text-sm text-ink-muted transition-colors hover:border-line-bright hover:text-ink"
      >
        CV (PDF)
      </a>
    </div>
  </section>

  <!-- ===================================================================
       Hero artifact — the 334 → 3 panel
  =================================================================== -->
  <section class="mx-auto max-w-5xl px-5 pb-24" aria-labelledby="artifact-heading">
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p class="label label-signal">Hero artifact</p>
        <h2 id="artifact-heading" class="mt-2 text-xl font-semibold">
          Why the interface mattered more than the model
        </h2>
      </div>
      <a
        href="/work/mcp-334-to-3"
        class="hidden shrink-0 font-mono text-xs text-ink-muted transition-colors hover:text-signal sm:block"
      >
        full case study →
      </a>
    </div>

    <ContextPanels />
  </section>

  <!-- ===================================================================
       Practice areas
  =================================================================== -->
  <section class="mx-auto max-w-5xl px-5 py-16" aria-labelledby="practice-heading">
    <SectionHeader
      id="practice-heading"
      eyebrow="What I do"
      title="Six practice areas, each attached to the work that proves it"
      lede="No skill appears on this site detached from the system it was used to build."
    />

    <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        practiceAreas.map((area) => (
          <article class="bg-surface p-6 transition-colors hover:bg-surface-2">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-semibold">{area.title}</h3>
              <span class="shrink-0 font-mono text-xs text-ink-faint">{area.duration}</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{area.blurb}</p>
            <p class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
              {area.proof.map((slug) => (
                <a
                  href={`/work/${slug}`}
                  class="font-mono text-[11px] text-signal transition-opacity hover:opacity-70"
                >
                  ↳ {workBySlug(slug)?.kicker}
                </a>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ===================================================================
       Selected work
  =================================================================== -->
  <section id="work" class="mx-auto max-w-5xl px-5 py-16" aria-labelledby="work-heading">
    <SectionHeader
      id="work-heading"
      eyebrow="Selected work"
      title="Five systems, and what each one turned on"
      lede="Every figure below sits next to the thing that produced it. None of them are decoration."
    />

    <div class="mt-10 space-y-px overflow-hidden rounded-lg border border-line bg-line">
      {
        work.map((item, i) => (
          <a
            href={`/work/${item.slug}`}
            class="group block bg-surface p-6 transition-colors hover:bg-surface-2 sm:p-8"
          >
            <div class="grid gap-6 sm:grid-cols-[1fr_auto] sm:items-start">
              <div>
                <p class="label">
                  {String(i + 1).padStart(2, '0')} · {item.kicker}
                </p>
                <h3 class="mt-2 text-xl font-semibold transition-colors group-hover:text-signal">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-2xl leading-relaxed text-ink-muted">{item.summary}</p>
                <p class="mt-4 flex flex-wrap gap-2">
                  {item.tags.map((tag) => (
                    <span class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-ink-faint">
                      {tag}
                    </span>
                  ))}
                </p>
              </div>

              <div class="sm:w-40 sm:text-right">
                <p class="figure text-2xl font-medium">{item.figure}</p>
                <p class="mt-1 text-xs leading-snug text-ink-faint">{item.figureNote}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================================================================
       Placeholders — bodies land in Phase 2 / Phase 3
  =================================================================== -->
  <section id="root-cause" class="mx-auto max-w-5xl px-5 py-16">
    <SectionHeader
      eyebrow="Root cause"
      title="Six production failures, and how each one was actually found"
      lede="Symptom, hypothesis, real cause, measured delta. The section almost nobody publishes — in progress."
    />
  </section>

  <section id="research" class="mx-auto max-w-5xl px-5 py-16">
    <SectionHeader
      eyebrow="Research"
      title="A hybrid rule-base and ML decision-support system, built on real-world evidence"
      lede="First-author, arXiv — a 59-condition ICD-10 rule base fused with multi-class prediction over routine labs, across 593,055 patients at 547 US primary-care centres."
    />
    <p class="mt-6">
      <a href={links.paper} target="_blank" rel="noopener" class="link-underline text-signal">
        Read it on arXiv →
      </a>
    </p>
  </section>

  <section id="trajectory" class="mx-auto max-w-5xl px-5 py-16">
    <SectionHeader
      eyebrow="Trajectory"
      title="From trading bots in 2020 to production agents in 2026"
      lede="An interactive timeline — freelance MQL, a WebSocket crypto bot, clinical ML at CureMD, then four AI products. In progress."
    />
  </section>

  <section id="about" class="mx-auto max-w-5xl px-5 py-16">
    <SectionHeader
      eyebrow="About"
      title="How I work"
      lede="Measure before recommending. Ship the fix with the before/after attached. File the residual risk rather than hide it. In progress."
    />
  </section>
</Base>
