---
import { nav, links } from '../data/site';
---

<div class="sticky top-0 z-40 px-4 pt-4">
  <header
    class="mx-auto max-w-7xl rounded-2xl border border-white/8 bg-canvas/70 backdrop-blur-xl"
    style="box-shadow: inset 0 1px 0 0 rgb(255 255 255 / 0.05), 0 8px 30px -12px rgb(0 0 0 / 0.9);"
  >
    <nav
      aria-label="Primary"
      class="flex h-14 items-center justify-between gap-6 px-4 sm:px-5"
    >
      <a
        href="/"
        class="flex items-center gap-2 font-mono text-sm font-medium tracking-tight text-ink transition-opacity hover:opacity-80"
      >
        <span
          class="grid size-6 place-items-center rounded-md border border-signal-dim/60 text-[10px] text-signal"
          style="background: radial-gradient(120% 120% at 0% 0%, rgb(77 212 200 / 0.25), transparent 70%);"
        >
          HM
        </span>
        <span class="hidden sm:inline">Hammad Maqsood</span>
      </a>

      <ul class="hidden items-center gap-1 md:flex">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-lg px-3 py-1.5 text-sm text-ink-muted transition-colors hover:bg-white/5 hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={links.paper}
          class="hidden rounded-lg px-3 py-1.5 text-sm text-ink-muted transition-colors hover:bg-white/5 hover:text-ink sm:inline-block"
          target="_blank"
          rel="noopener"
        >
          Paper
        </a>
        <a
          href={links.linkedin}
          class="rounded-lg px-3 py-1.5 text-sm text-ink-muted transition-colors hover:bg-white/5 hover:text-ink"
          target="_blank"
          rel="noopener"
        >
          LinkedIn
        </a>
        <a
          href="#contact"
          class="hidden rounded-lg px-3 py-1.5 text-sm text-ink-muted transition-colors hover:bg-white/5 hover:text-ink md:inline-block"
        >
          Contact
        </a>
        <a
          href={links.cv}
          class="rounded-lg border border-signal-dim/70 px-3 py-1.5 font-mono text-xs tracking-wide text-signal transition-colors hover:border-signal hover:bg-signal/10"
        >
          CV
        </a>
      </div>
    </nav>
  </header>
</div>
