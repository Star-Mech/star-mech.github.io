---
import Base from '../layouts/Base.astro';
import { work, links } from '../data/site';
---

<Base
  title="Not found · Hammad Maqsood"
  description="That page does not exist. The work, the paper and the CV are all one click away."
>
  <section class="mx-auto max-w-7xl px-4 pt-16 pb-24">
    <div class="tile tile-glow p-6 sm:p-10">
      <p class="label label-signal">404</p>
      <h1 class="mt-3 text-[length:var(--text-section)] font-bold leading-tight">
        Nothing at this address
      </h1>
      <p class="mt-4 max-w-xl leading-relaxed text-ink-muted">
        The link is wrong or the page moved. Everything on this site is reachable from the home page,
        and the seven case studies are listed below.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="/" class="btn-primary">Home →</a>
        <a href={links.paper} target="_blank" rel="noopener" class="btn-ghost">Read the paper</a>
        <a href={links.cv} class="btn-ghost">CV (PDF)</a>
      </div>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        work.map((item) => (
          <a href={`/work/${item.slug}`} class="tile tile-interactive tile-glow group p-5">
            <p class="label">{item.kicker}</p>
            <h2 class="mt-1.5 text-sm font-semibold transition-colors group-hover:text-signal">
              {item.title}
            </h2>
            <p class="figure mt-3 text-lg">{item.figure}</p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
