---
import { profile, links } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-32 border-t border-line">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div>
        <p class="label">Contact</p>
        <a
          href={`mailto:${links.email}`}
          class="mt-2 block font-mono text-sm text-ink link-underline"
        >
          {links.email}
        </a>
        <p class="mt-3 text-sm text-ink-muted">{profile.availability}</p>
      </div>

      <div class="flex flex-col gap-2">
        <p class="label">Elsewhere</p>
        <a
          href={links.linkedin}
          target="_blank"
          rel="noopener"
          class="text-sm text-ink-muted transition-colors hover:text-ink"
        >
          LinkedIn
        </a>
        <a
          href={links.github}
          target="_blank"
          rel="noopener"
          class="text-sm text-ink-muted transition-colors hover:text-ink"
        >
          GitHub <span class="text-ink-faint">— personal</span>
        </a>
        <a
          href={links.githubWork}
          target="_blank"
          rel="noopener"
          class="text-sm text-ink-muted transition-colors hover:text-ink"
        >
          GitHub <span class="text-ink-faint">— work history</span>
        </a>
        <a
          href={links.paper}
          target="_blank"
          rel="noopener"
          class="text-sm text-ink-muted transition-colors hover:text-ink"
        >
          arXiv paper
        </a>
      </div>
    </div>

    <p class="mt-12 font-mono text-xs text-ink-faint">
      © {year} {profile.name} · {profile.location} · {profile.remote}
    </p>
  </div>
</footer>
