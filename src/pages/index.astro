---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContextPanels from '../components/ContextPanels.astro';
import TraceReadout from '../components/TraceReadout.astro';
import MiniViz from '../components/MiniViz.astro';
import { profile, links, practiceAreas, work, workBySlug, workViz } from '../data/site';

const [lead, ...rest] = work;

/** The three things a stranger can verify without taking his word for it. */
const artifacts = [
  {
    label: 'Peer-facing',
    title: 'First-author paper, arXiv',
    body:
      'A hybrid rule base of 59 ICD-10 conditions fused with multi-class prediction over routine labs — built on real-world evidence from 593,055 patients across 547 US primary-care centres.',
    href: links.paper,
    cta: 'Read on arXiv',
  },
  {
    label: 'Shipped & live',
    title: 'A hosted MCP server in customer hands',
    body:
      'The Gensym G2 documentation copilot, running as an authenticated product with per-customer keys — 40 tools over 3,400+ pages of manuals.',
    href: links.gensym,
    cta: 'Visit the product',
  },
  {
    label: 'Open source',
    title: 'openrpc-mcp-server-updated',
    body:
      'A stale community OpenRPC MCP server, forked and modernised so current clients could use it — published to npm and the base of the three-tool architecture.',
    href: links.npm,
    cta: 'View on npm',
  },
];
---

<Base>
  <!-- ===================================================================
       Hero — two tiles, no dead space
  =================================================================== -->
  <section class="mx-auto max-w-7xl px-4 pt-10 pb-4 sm:pt-16">
    <div class="grid gap-4 lg:grid-cols-12">
      <!-- Headline tile -->
      <div class="tile tile-glow flex flex-col justify-between p-6 sm:p-9 lg:col-span-7">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="pill">
              <span class="dot-live"></span>
              Open to work · immediate
            </span>
            <span class="pill">{profile.location} · {profile.remote}</span>
          </div>

          <h1 class="mt-6 text-[length:var(--text-hero)] font-bold leading-[1.06]">
            I build <span class="grad-text">production LLM agents</span>, MCP interfaces, and the{' '}
            <span class="grad-fade">MLOps underneath them.</span>
          </h1>

          <p class="mt-5 max-w-xl leading-relaxed text-ink-muted">
            {profile.stance}
          </p>
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#work" class="btn-primary">See the work →</a>
          <a href={links.paper} target="_blank" rel="noopener" class="btn-ghost">Read the paper</a>
          <a href={links.cv} class="btn-ghost">CV (PDF)</a>
        </div>
      </div>

      <!-- Instrument tile -->
      <div class="lg:col-span-5">
        <TraceReadout />
      </div>
    </div>
  </section>

  <!-- ===================================================================
       Independently checkable
  =================================================================== -->
  <section class="mx-auto max-w-7xl px-4 py-4">
    <p class="label mb-3 px-1">Independently checkable — not just my description of private work</p>
    <div class="grid gap-4 md:grid-cols-3">
      {
        artifacts.map((a, i) => (
          <a
            href={a.href}
            target="_blank"
            rel="noopener"
            class={`tile tile-interactive reveal group flex flex-col p-6 ${
              i === 1 ? 'tile-glow tile-glow-2' : 'tile-glow'
            }`}
            style={`transition-delay:${i * 70}ms`}
          >
            <p class="label label-signal">{a.label}</p>
            <h3 class="mt-2.5 font-semibold leading-snug">{a.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{a.body}</p>
            <p class="mt-5 font-mono text-xs text-signal">
              {a.cta}
              <span class="inline-block transition-transform group-hover:translate-x-1">↗</span>
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================================================================
       Hero artifact — the 334 → 3 panel
  =================================================================== -->
  <section class="mx-auto max-w-7xl px-4 py-14" aria-labelledby="artifact-heading">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-4 px-1">
      <div>
        <p class="label label-signal">The idea the rest of it rests on</p>
        <h2 id="artifact-heading" class="mt-2 text-xl font-semibold sm:text-2xl">
          Why the interface mattered more than the model
        </h2>
      </div>
      <a
        href="/work/mcp-334-to-3"
        class="shrink-0 font-mono text-xs text-ink-muted transition-colors hover:text-signal"
      >
        full case study →
      </a>
    </div>

    <div class="reveal">
      <ContextPanels />
    </div>
  </section>

  <!-- ===================================================================
       Practice areas
  =================================================================== -->
  <section class="mx-auto max-w-7xl px-4 py-14" aria-labelledby="practice-heading">
    <div class="px-1">
      <SectionHeader
        id="practice-heading"
        eyebrow="What I do"
        title="Six practice areas, each bolted to the work that proves it"
        lede="No skill appears on this site detached from the system it was used to build."
      />
    </div>

    <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        practiceAreas.map((area, i) => (
          <article
            class="tile tile-interactive tile-glow reveal flex flex-col p-6"
            style={`transition-delay:${(i % 3) * 70}ms`}
          >
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-semibold">{area.title}</h3>
              <span class="shrink-0 font-mono text-[11px] text-ink-faint">{area.duration}</span>
            </div>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{area.blurb}</p>
            <p class="mt-5 flex flex-wrap gap-x-3 gap-y-1">
              {area.proof.map((slug) => (
                <a
                  href={`/work/${slug}`}
                  class="font-mono text-[11px] text-signal transition-opacity hover:opacity-70"
                >
                  ↳ {workBySlug(slug)?.kicker}
                </a>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ===================================================================
       Selected work — one feature tile, then a 2×2 bento
  =================================================================== -->
  <section id="work" class="mx-auto max-w-7xl px-4 py-14" aria-labelledby="work-heading">
    <div class="px-1">
      <SectionHeader
        id="work-heading"
        eyebrow="Selected work"
        title="Five systems, and what each one turned on"
        lede="Every figure sits beside the thing that produced it. None of them are decoration."
      />
    </div>

    <!-- Feature -->
    <a
      href={`/work/${lead.slug}`}
      class="tile tile-interactive tile-glow reveal group mt-9 grid gap-6 p-6 sm:p-8 lg:grid-cols-12"
    >
      <div class="lg:col-span-7">
        <p class="label">01 · {lead.kicker}</p>
        <h3 class="mt-2 text-2xl font-semibold transition-colors group-hover:text-signal">
          {lead.title}
        </h3>
        <p class="mt-3 max-w-2xl leading-relaxed text-ink-muted">{lead.summary}</p>
        <p class="mt-5 flex flex-wrap gap-2">
          {lead.tags.map((tag) => <span class="tag">{tag}</span>)}
        </p>
      </div>

      <div class="flex flex-col justify-between gap-5 lg:col-span-5">
        <div>
          <p class="figure text-4xl font-medium">{lead.figure}</p>
          <p class="mt-1.5 text-xs leading-snug text-ink-faint">{lead.figureNote}</p>
        </div>
        <MiniViz kind={workViz[lead.slug]} />
      </div>
    </a>

    <!-- The other four -->
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      {
        rest.map((item, i) => (
          <a
            href={`/work/${item.slug}`}
            class={`tile tile-interactive reveal group flex flex-col p-6 sm:p-7 ${
              i % 2 === 0 ? 'tile-glow' : 'tile-glow tile-glow-2'
            }`}
            style={`transition-delay:${(i % 2) * 70}ms`}
          >
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="label">
                  {String(i + 2).padStart(2, '0')} · {item.kicker}
                </p>
                <h3 class="mt-2 text-lg font-semibold transition-colors group-hover:text-signal">
                  {item.title}
                </h3>
              </div>
              <p class="figure shrink-0 text-2xl font-medium">{item.figure}</p>
            </div>

            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{item.summary}</p>

            <div class="mt-6 rounded-xl border border-white/6 bg-black/25 p-4">
              <MiniViz kind={workViz[item.slug]} />
            </div>

            <p class="mt-5 flex flex-wrap gap-2">
              {item.tags.slice(0, 4).map((tag) => <span class="tag">{tag}</span>)}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ===================================================================
       Sections still being written
  =================================================================== -->
  <section id="root-cause" class="mx-auto max-w-7xl px-4 py-14">
    <div class="tile tile-glow reveal p-6 sm:p-9">
      <SectionHeader
        eyebrow="Root cause"
        title="Six production failures, and how each one was actually found"
        lede="Symptom, hypothesis, real cause, measured delta — the section almost nobody publishes. In progress."
      />
    </div>
  </section>

  <section id="research" class="mx-auto max-w-7xl px-4 py-14">
    <div class="tile tile-glow tile-glow-2 reveal p-6 sm:p-9">
      <SectionHeader
        eyebrow="Research"
        title="A hybrid rule-base and ML decision-support system, on real-world evidence"
        lede="First-author, arXiv — a 59-condition ICD-10 rule base fused with multi-class prediction over routine labs, across 593,055 patients at 547 US primary-care centres."
      />
      <p class="mt-6">
        <a href={links.paper} target="_blank" rel="noopener" class="btn-ghost">Read it on arXiv ↗</a>
      </p>
    </div>
  </section>

  <section id="trajectory" class="mx-auto max-w-7xl px-4 py-14">
    <div class="tile tile-glow reveal p-6 sm:p-9">
      <SectionHeader
        eyebrow="Trajectory"
        title="From trading bots in 2020 to production agents in 2026"
        lede="An interactive timeline — freelance MQL work, a WebSocket crypto bot, clinical ML at CureMD, then four AI products. In progress."
      />
    </div>
  </section>

  <section id="about" class="mx-auto max-w-7xl px-4 py-14">
    <div class="tile tile-glow tile-glow-2 reveal p-6 sm:p-9">
      <SectionHeader
        eyebrow="About"
        title="How I work"
        lede="Measure before recommending. Ship the fix with the before and after attached. File the residual risk rather than hide it. In progress."
      />
    </div>
  </section>
</Base>
