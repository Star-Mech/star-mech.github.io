---
/**
 * The RADAR pipeline, as a clickable diagram.
 *
 * Hand-authored rather than generated: the connectors and hit areas need to be
 * exact, and the dark palette has to match the rest of the site.
 *
 * Structure: an SVG draws only the rails and arrows; the nodes themselves are
 * real <button> elements in a CSS grid layered over it. That way focus rings,
 * tab order, hit areas and Enter/Space all come from the platform instead of
 * being reimplemented on <g> elements.
 *
 * Without JavaScript the overview panel stays rendered and every node still
 * reads as a labelled stage — the diagram is informative before any click.
 */

interface Node {
  id: string;
  label: string;
  sub: string;
  /** grid column (1-4) and row (1-3) */
  col: number;
  row: number;
  detail: string;
  metric?: string;
}

const nodes: Node[] = [
  {
    id: 'ingest',
    label: 'Ingestion',
    sub: 'push, OIDC',
    col: 1,
    row: 1,
    detail:
      'Migrated from a lossy polling architecture — seven or more fetch calls per appliance — to a single OIDC-protected push call, removing a documented data-loss failure mode. The migration script itself was optimised to cut database operations sharply on large runs.',
    metric: '~23× fewer DB operations',
  },
  {
    id: 'prep',
    label: 'Data prep',
    sub: 'search cluster → S3',
    col: 2,
    row: 1,
    detail:
      'Redesigned the datalake partition layout to timestamp-based folders after measuring the per-appliance scheme roughly twice as slow. That fixed a Spark partitioning bottleneck and is what made event-triggered inference possible at all.',
    metric: '~2× faster partitioning',
  },
  {
    id: 'train',
    label: 'Training',
    sub: 'per-appliance',
    col: 3,
    row: 1,
    detail:
      'Per-appliance model selection with the scaler and explainer persisted to the registry. Found and fixed an accidental double-normalisation that had been feeding effectively unnormalised data into training, then retrained the affected models.',
  },
  {
    id: 'eval',
    label: 'Evaluate',
    sub: 'temporal splits',
    col: 4,
    row: 1,
    detail:
      'Re-architected random splits into temporal ones after finding 300 of 3,300 evaluation points were data the model had trained on. Then optimised the decision threshold on the now-honest numbers.',
    metric: 'precision 0.35 → 0.72',
  },
  {
    id: 'champion',
    label: 'Champion selection',
    sub: 'state machine',
    col: 4,
    row: 2,
    detail:
      'A state-machine pipeline for train, evaluate and promote, hard-linking registry run ids to kill a parallel-training race condition. Inline alias-based promotion with configurable performance-tolerance bands, validated across parallel multi-appliance execution.',
  },
  {
    id: 'registry',
    label: 'Registry',
    sub: 'audit trail',
    col: 3,
    row: 2,
    detail:
      'Timestamped champion audit tags queryable inside the registry, one promotion path shared by the automated and manual routes, and naming conventions separating experiments from production. Hyperparameters discovered during training write back into config, so the search re-centres itself and stays drift-resistant.',
  },
  {
    id: 'inference',
    label: 'Inference',
    sub: 'event-triggered',
    col: 2,
    row: 2,
    detail:
      'An event-triggered function writing calibrated probabilities to PostgreSQL, with a queue hand-off for feature attribution. The unsupervised path runs in parallel with the supervised one and the results are aggregated.',
  },
  {
    id: 'explain',
    label: 'Explainability',
    sub: 'attribution',
    col: 1,
    row: 2,
    detail:
      'Feature attribution feeding the generated insights — including the sign-attribution fix, without which an explanation could confidently cite a feature that was pushing the record toward normal rather than toward anomalous.',
  },
  {
    id: 'actions',
    label: 'Insights & actions',
    sub: 'GeoIP quick actions',
    col: 1,
    row: 3,
    detail:
      'Firewall block and unblock actions delivered end to end across three repositories, verified against a real appliance across 230 country codes. Also where the silent no-op lived: confirmed attacks were producing zero actions because no attacker address was ever being captured.',
    metric: '0 of 1,137 → attacker IP extracted',
  },
  {
    id: 'monitor',
    label: 'Monitoring',
    sub: 'fleet dashboard',
    col: 2,
    row: 3,
    detail:
      'Fleet overview, per-appliance drilldown, threshold optimisation, champion-transition markers and decline alerts, designed toward a thousand-plus models — then three separate monitoring services consolidated into one multipage application.',
    metric: '3 services → 1',
  },
];

const overview = {
  label: 'The pipeline',
  detail:
    'Appliance telemetry arrives by push, is prepared into a modelling set, trains per-appliance models, and the winner is promoted automatically with an audit trail. Inference runs on an event trigger, attribution explains each anomaly, and the result becomes a recommended firewall action a human can take. I was the sole hands-on engineer across all of it.',
  metric: 'select any stage',
};
---

<div class="tile tile-glow overflow-hidden" data-radar>
  <div class="border-b border-white/6 px-5 py-4 sm:px-6">
    <p class="label label-signal">Architecture</p>
    <h3 class="mt-1.5 font-semibold">The pipeline, stage by stage</h3>
    <p class="mt-1 text-xs text-ink-faint">
      Select a stage to see what I built there. Ten stages, all of them mine.
    </p>
  </div>

  <div class="grid lg:grid-cols-12">
    <!-- Diagram. Sequence is carried by the numbers rather than by drawn
         connectors: rails over a CSS grid mean two layout systems that have to
         agree at every breakpoint, and they drift. Numbers never do, and they
         read correctly to a screen reader. -->
    <div class="p-5 sm:p-6 lg:col-span-7">
      <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
        {
          nodes.map((n, i) => (
            <button
              type="button"
              data-node={n.id}
              style={`grid-column:${n.col}; grid-row:${n.row}`}
              class="group rounded-lg border border-white/8 bg-black/30 px-2.5 py-2.5 text-left transition-colors hover:border-signal-dim aria-pressed:border-signal aria-pressed:bg-signal/10"
              aria-pressed="false"
            >
              <span class="flex items-baseline gap-1.5">
                <span class="font-mono text-[10px] text-signal/70">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-[13px] leading-tight font-medium text-ink">{n.label}</span>
              </span>
              <span class="mt-0.5 block font-mono text-[10px] leading-tight text-ink-faint">
                {n.sub}
              </span>
            </button>
          ))
        }
      </div>

      <p class="mt-4 font-mono text-[10px] leading-relaxed text-ink-faint">
        telemetry arrives at 01 and leaves as an action at 09 · 10 watches the fleet
      </p>
    </div>

    <!-- Detail panel -->
    <div class="border-t border-white/6 bg-black/20 p-5 sm:p-6 lg:col-span-5 lg:border-t-0 lg:border-l">
      <p class="label" data-rd-label>{overview.label}</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted" data-rd-detail>{overview.detail}</p>
      <p class="figure mt-4 font-mono text-xs" data-rd-metric>{overview.metric}</p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ nodes, overview }}>
  /**
   * Fills the detail panel from the selected stage. The panel already contains
   * the overview server-side, so with no JavaScript the diagram still explains
   * itself and every node still reads as a labelled stage.
   */
  (() => {
    const root = document.querySelector('[data-radar]');
    if (!root) return;

    const labelEl = root.querySelector('[data-rd-label]');
    const detailEl = root.querySelector('[data-rd-detail]');
    const metricEl = root.querySelector('[data-rd-metric]');
    const buttons = Array.from(root.querySelectorAll('[data-node]'));
    if (!labelEl || !detailEl || !metricEl || !buttons.length) return;

    const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

    function show(id) {
      const n = id ? byId[id] : null;
      labelEl.textContent = n ? n.label : overview.label;
      detailEl.textContent = n ? n.detail : overview.detail;
      metricEl.textContent = n ? n.metric || '' : overview.metric;
      metricEl.hidden = !metricEl.textContent;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.node === id)));
    }

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const already = b.getAttribute('aria-pressed') === 'true';
        show(already ? null : b.dataset.node);
      })
    );
  })();
</script>
