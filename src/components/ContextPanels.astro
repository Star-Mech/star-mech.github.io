---
/**
 * The 334 → 3 panel.
 *
 * Static, no-JavaScript form: correct, legible, and the exact fallback served
 * under `prefers-reduced-motion`. Phase 3 layers a steppable island on top of
 * this same markup and numbers.
 *
 * Note on the schema wall: 334 bars are actually drawn. A representative
 * handful would undersell the problem the architecture exists to solve.
 */

const schemaCount = 334;
const schemas = Array.from({ length: schemaCount }, (_, i) => i);

const steps = [
  {
    call: 'rpc_discover',
    detail: 'Returns method names only — no schemas. A directory, not a manual.',
  },
  {
    call: 'rpc_method_detail',
    detail: 'Pulls the full schema for the one method the model chose.',
  },
  {
    call: 'rpc_call',
    detail: 'Invokes it. Context holds three tool definitions, start to finish.',
  },
];
---

<div class="tile tile-glow overflow-hidden">
  <div class="grid md:grid-cols-2 md:divide-x md:divide-white/6">
    <!-- ---------------------------------------------------------------
         Left: the obvious approach
    --------------------------------------------------------------- -->
    <section class="flex flex-col p-6 sm:p-8" aria-labelledby="panel-naive">
      <div class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-fail"></span>
        <p class="label">The obvious approach</p>
      </div>
      <h3 id="panel-naive" class="mt-2 text-lg font-semibold">One tool per method</h3>

      <div
        class="mt-6"
        role="img"
        aria-label="Context window meter, filled past its limit marker"
      >
        <div class="flex items-baseline justify-between">
          <span class="label">context window</span>
          <span class="font-mono text-xs text-fail">over limit</span>
        </div>
        <div class="relative mt-2 h-2 w-full rounded-full bg-white/6">
          <div class="h-2 w-full rounded-full bg-fail/75"></div>
          <div class="absolute -top-1 right-[18%] h-4 w-px bg-ink-faint"></div>
          <span
            class="absolute -top-5 right-[18%] translate-x-1/2 font-mono text-[10px] text-ink-faint"
          >
            limit
          </span>
        </div>
      </div>

      <!-- The wall. All 334 of them. -->
      <div class="mt-7">
        <p class="label mb-2">334 tool schemas, resident</p>
        <div class="flex flex-wrap gap-[3px]" aria-hidden="true">
          {
            schemas.map((i) => (
              <span
                class="h-1.5 w-[7px] rounded-[1px] bg-fail"
                style={`opacity:${Math.max(0.1, 0.85 - (i / schemaCount) * 0.75)}`}
              />
            ))
          }
        </div>
      </div>

      <p class="mt-6 text-sm leading-relaxed text-ink-muted">
        Every one of them sits in context on every single request. The window is spent before the
        model has reasoned about anything, and tool selection degrades as the list grows.
      </p>

      <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-white/6 pt-5">
        <span class="label">cost</span>
        <span class="font-mono text-xs text-fail">paid in full, on every request</span>
      </div>
    </section>

    <!-- ---------------------------------------------------------------
         Right: what shipped
    --------------------------------------------------------------- -->
    <section
      class="flex flex-col bg-white/[0.015] p-6 sm:p-8"
      aria-labelledby="panel-design"
    >
      <div class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-signal"></span>
        <p class="label label-signal">What shipped</p>
      </div>
      <h3 id="panel-design" class="mt-2 text-lg font-semibold">
        Three tools, progressive disclosure
      </h3>

      <div class="mt-6" role="img" aria-label="Context window meter, nearly empty and flat">
        <div class="flex items-baseline justify-between">
          <span class="label">context window</span>
          <span class="font-mono text-xs text-signal">flat</span>
        </div>
        <div class="relative mt-2 h-2 w-full rounded-full bg-white/6">
          <div
            class="h-2 w-[6%] rounded-full bg-signal"
            style="box-shadow: 0 0 12px 0 rgb(77 212 200 / 0.6);"
          >
          </div>
          <div class="absolute -top-1 right-[18%] h-4 w-px bg-ink-faint"></div>
        </div>
      </div>

      <div class="mt-7">
        <p class="label mb-2">3 tool definitions, resident</p>
        <div class="flex gap-[3px]" aria-hidden="true">
          {[0, 1, 2].map(() => <span class="h-1.5 w-[7px] rounded-[1px] bg-signal" />)}
        </div>

        <ol class="mt-5 space-y-3.5">
          {
            steps.map((step, i) => (
              <li class="flex gap-3">
                <span
                  class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-signal-dim font-mono text-[10px] text-signal"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div>
                  <code class="font-mono text-sm text-ink">{step.call}</code>
                  <p class="mt-0.5 text-sm leading-relaxed text-ink-muted">{step.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <p class="mt-6 text-sm leading-relaxed text-ink-muted">
        The model asks what exists, then asks about one thing, then acts. All{' '}
        <span class="figure">334</span> methods stay reachable —{' '}
        <span class="figure">3</span> tool definitions stay resident.
      </p>

      <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-white/6 pt-5">
        <span class="label">cost</span>
        <span class="font-mono text-xs text-signal">one schema, once, on demand</span>
      </div>
    </section>
  </div>
</div>
