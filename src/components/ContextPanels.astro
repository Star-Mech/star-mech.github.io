---
/**
 * The 334 → 3 panel.
 *
 * The server-rendered markup below is the complete, correct end state, and is
 * also exactly what a no-JavaScript or reduced-motion visitor gets. The inline
 * script at the bottom only adds the ability to walk the three calls one at a
 * time — no framework, and no control that exists without behaviour.
 *
 * Note on the schema wall: 334 bars are actually drawn. A representative
 * handful would undersell the problem the architecture exists to solve.
 */

const schemaCount = 334;
const schemas = Array.from({ length: schemaCount }, (_, i) => i);

const steps = [
  {
    call: 'rpc_discover',
    detail: 'Returns method names only — no schemas. A directory, not a manual.',
    /**
     * What comes back, shown when this step is active. Deliberately generic —
     * the evidence does not record specific method names, so none are invented.
     */
    returns: '334 method names · no schemas attached',
  },
  {
    call: 'rpc_method_detail',
    detail: 'Pulls the full schema for the one method the model chose.',
    returns: '1 schema — params, types, required fields',
  },
  {
    call: 'rpc_call',
    detail: 'Invokes it. Context holds three tool definitions, start to finish.',
    returns: '200 OK — the appliance did the thing',
  },
];
---

<div class="tile tile-glow overflow-hidden" data-context-panels>
  <div class="grid md:grid-cols-2 md:divide-x md:divide-white/6">
    <!-- ---------------------------------------------------------------
         Left: the obvious approach
    --------------------------------------------------------------- -->
    <section class="flex flex-col p-6 sm:p-8" aria-labelledby="panel-naive">
      <div class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-fail"></span>
        <p class="label">The obvious approach</p>
      </div>
      <h3 id="panel-naive" class="mt-2 text-lg font-semibold">One tool per method</h3>

      <div
        class="mt-6"
        role="img"
        aria-label="Context window meter, filled past its limit marker"
      >
        <div class="flex items-baseline justify-between">
          <span class="label">context window</span>
          <span class="font-mono text-xs text-fail">over limit</span>
        </div>
        <div class="relative mt-2 h-2 w-full rounded-full bg-white/6">
          <div class="h-2 w-full rounded-full bg-fail/75"></div>
          <div class="absolute -top-1 right-[18%] h-4 w-px bg-ink-faint"></div>
          <span
            class="absolute -top-5 right-[18%] translate-x-1/2 font-mono text-[10px] text-ink-faint"
          >
            limit
          </span>
        </div>
      </div>

      <!-- The wall. All 334 of them. -->
      <div class="mt-7">
        <p class="label mb-2">334 tool schemas, resident</p>
        <div class="flex flex-wrap gap-[3px]" aria-hidden="true">
          {
            schemas.map((i) => (
              <span
                class="h-1.5 w-[7px] rounded-[1px] bg-fail"
                style={`opacity:${Math.max(0.1, 0.85 - (i / schemaCount) * 0.75)}`}
              />
            ))
          }
        </div>
      </div>

      <p class="mt-6 text-sm leading-relaxed text-ink-muted">
        Every one of them sits in context on every single request. The window is spent before the
        model has reasoned about anything, and tool selection degrades as the list grows.
      </p>

      <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-white/6 pt-5">
        <span class="label">cost</span>
        <span class="font-mono text-xs text-fail">paid in full, on every request</span>
      </div>
    </section>

    <!-- ---------------------------------------------------------------
         Right: what shipped
    --------------------------------------------------------------- -->
    <section
      class="flex flex-col bg-white/[0.015] p-6 sm:p-8"
      aria-labelledby="panel-design"
    >
      <div class="flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-signal"></span>
        <p class="label label-signal">What shipped</p>
      </div>
      <h3 id="panel-design" class="mt-2 text-lg font-semibold">
        Three tools, progressive disclosure
      </h3>

      <div class="mt-6" role="img" aria-label="Context window meter, nearly empty and flat">
        <div class="flex items-baseline justify-between">
          <span class="label">context window</span>
          <span class="font-mono text-xs text-signal">flat</span>
        </div>
        <div class="relative mt-2 h-2 w-full rounded-full bg-white/6">
          <div
            class="h-2 w-[6%] rounded-full bg-signal"
            style="box-shadow: 0 0 12px 0 rgb(77 212 200 / 0.6);"
          >
          </div>
          <div class="absolute -top-1 right-[18%] h-4 w-px bg-ink-faint"></div>
        </div>
      </div>

      <div class="mt-7">
        <p class="label mb-2">3 tool definitions, resident</p>
        <div class="flex gap-[3px]" aria-hidden="true">
          {[0, 1, 2].map(() => <span class="h-1.5 w-[7px] rounded-[1px] bg-signal" />)}
        </div>

        <ol class="mt-5 space-y-3.5">
          {
            steps.map((step, i) => (
              <li class="flex gap-3" data-step={i}>
                <span
                  class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full border border-signal-dim font-mono text-[10px] text-signal transition-colors"
                  data-marker
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div class="min-w-0">
                  <code class="font-mono text-sm text-ink">{step.call}</code>
                  <p class="mt-0.5 text-sm leading-relaxed text-ink-muted">{step.detail}</p>
                  <p
                    data-returns
                    hidden
                    class="mt-1.5 rounded border border-signal-dim/50 bg-signal/5 px-2 py-1 font-mono text-[11px] leading-relaxed text-signal"
                  >
                    ↩ {step.returns}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <!-- Controls. Rendered hidden and revealed by the enhancement script, so
             a no-JS visitor never sees a dead button. -->
        <div data-controls hidden class="mt-5 flex flex-wrap items-center gap-2">
          <span class="label">walk it</span>
          {
            steps.map((step, i) => (
              <button
                type="button"
                data-goto={i}
                class="rounded-md border border-white/10 px-3 py-2 font-mono text-[11px] text-ink-muted transition-colors hover:border-signal-dim hover:text-ink aria-pressed:border-signal aria-pressed:bg-signal/10 aria-pressed:text-signal"
                aria-pressed="false"
              >
                {i + 1}. {step.call}
              </button>
            ))
          }
          <button
            type="button"
            data-reset
            class="rounded-md px-3 py-2 font-mono text-[11px] text-ink-faint transition-colors hover:text-ink"
          >
            reset
          </button>
        </div>
      </div>

      <p class="mt-6 text-sm leading-relaxed text-ink-muted">
        The model asks what exists, then asks about one thing, then acts. All{' '}
        <span class="figure">334</span> methods stay reachable —{' '}
        <span class="figure">3</span> tool definitions stay resident.
      </p>

      <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-white/6 pt-5">
        <span class="label">cost</span>
        <span class="font-mono text-xs text-signal">one schema, once, on demand</span>
      </div>
    </section>
  </div>
</div>

<script is:inline>
  /**
   * Progressive enhancement for the 334 → 3 panel.
   *
   * The markup above already renders the complete, correct end state. This only
   * adds the ability to walk the three calls one at a time. If the script never
   * runs, or the visitor asked for reduced motion, the controls stay hidden and
   * the panel reads exactly as it did before — there is no state in which a
   * control exists but does nothing.
   */
  (() => {
    const root = document.querySelector('[data-context-panels]');
    if (!root) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const controls = root.querySelector('[data-controls]');
    const stepEls = Array.from(root.querySelectorAll('[data-step]'));
    const buttons = Array.from(root.querySelectorAll('[data-goto]'));
    const resetBtn = root.querySelector('[data-reset]');
    if (!controls || !stepEls.length) return;

    function render(active) {
      stepEls.forEach((el, i) => {
        const on = active !== null && i <= active;
        const isCurrent = i === active;

        el.style.opacity = active === null || on ? '1' : '0.4';

        const marker = el.querySelector('[data-marker]');
        if (marker) {
          marker.classList.toggle('bg-signal', isCurrent);
          marker.classList.toggle('text-canvas', isCurrent);
          marker.classList.toggle('text-signal', !isCurrent);
        }

        const returns = el.querySelector('[data-returns]');
        if (returns) returns.hidden = !on;
      });

      buttons.forEach((b, i) =>
        b.setAttribute('aria-pressed', String(i === active))
      );
    }

    buttons.forEach((b) =>
      b.addEventListener('click', () => render(Number(b.dataset.goto)))
    );
    resetBtn?.addEventListener('click', () => render(null));

    controls.hidden = false;
    render(null);
  })();
</script>
