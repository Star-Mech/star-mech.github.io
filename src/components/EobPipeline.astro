</style>

<script is:inline define:vars={{ items, overview }}>
  /**
   * Fills the detail panel from the selected stage or barrier. The panel is
   * server-rendered with the overview and every card already carries its label,
   * what it does and what bounded it, so with no JavaScript the diagram is
   * still complete and every node still reads as a labelled stage.
   */
  (() => {
    const root = document.querySelector('[data-eob]');
    if (!root) return;

    const labelEl = root.querySelector('[data-eob-label]');
    const detailEl = root.querySelector('[data-eob-detail]');
    const metricEl = root.querySelector('[data-eob-metric]');
    const buttons = Array.from(root.querySelectorAll('[data-eob-node]'));
    const svgNodes = Array.from(root.querySelectorAll('[data-svg]'));
    if (!labelEl || !detailEl || !metricEl || !buttons.length) return;

    const byId = Object.fromEntries(items.map((n) => [n.id, n]));

    function show(id) {
      const n = id ? byId[id] : null;
      labelEl.textContent = n ? n.label : overview.label;
      detailEl.textContent = n ? n.detail : overview.detail;
      metricEl.hidden = Boolean(n);
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.eobNode === id)));
      svgNodes.forEach((g) => g.classList.toggle('is-active', g.dataset.svg === id));
    }

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const already = b.getAttribute('aria-pressed') === 'true';
        show(already ? null : b.dataset.eobNode);
      })
    );
  })();
</script>
