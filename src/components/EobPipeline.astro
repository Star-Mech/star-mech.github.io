  }

  /* Barriers get the violet token rather than warn or fail: a barrier is a
     synchronisation point, not a failure, and on this site a red bar always
     means something broke. */
  .eob-bar {
    display: block;
    width: 100%;
    text-align: left;
    border-radius: 0.375rem;
    border: 1px dashed rgb(167 139 250 / 0.4);
