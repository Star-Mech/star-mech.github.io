---
import { rootCauses } from '../data/root-causes';

/**
 * Native <details> elements. Keyboard-operable and screen-reader-correct with
 * no JavaScript, and every card is open by default to a search engine.
 */
---

<div class="grid items-start gap-3 lg:grid-cols-2">
  {
    rootCauses.map((rc, i) => (
      <details class="tile tile-glow group overflow-hidden [&[open]]:bg-surface-2/60">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-4 p-5 transition-colors hover:bg-white/[0.02]"
        >
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] text-ink-faint">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="label">{rc.kind}</span>
            </div>
            <p class="mt-2 leading-snug font-medium text-ink">{rc.symptom}</p>
          </div>
          <span
            class="mt-1 shrink-0 font-mono text-xs text-signal transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            +
          </span>
        </summary>

        <div class="space-y-4 border-t border-white/6 px-5 pt-5 pb-5">
          <div>
            <p class="label">Looked like</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-muted">{rc.looked_like}</p>
          </div>
          <div>
            <p class="label" style="color: var(--color-fail)">Actual cause</p>
            <p class="mt-1 text-sm leading-relaxed text-ink">{rc.cause}</p>
          </div>
          <div>
            <p class="label">Fix</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-muted">{rc.fix}</p>
          </div>
          <div class="rounded-lg border border-white/6 bg-black/25 p-3.5">
            <p class="label label-signal">Measured</p>
            <p class="mt-1 font-mono text-xs leading-relaxed text-ink">{rc.delta}</p>
          </div>
        </div>
      </details>
    ))
  }
</div>
