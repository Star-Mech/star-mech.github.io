    margin-right: 0.4rem;
  }

  .eob-t {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-ink);
  }

  .eob-s {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.45;
    color: var(--color-ink-faint);
