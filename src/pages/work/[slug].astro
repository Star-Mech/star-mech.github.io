---
import Base from '../../layouts/Base.astro';
import MiniViz from '../../components/MiniViz.astro';
import RadarDiagram from '../../components/RadarDiagram.astro';
import { work, workViz, profile } from '../../data/site';
import { caseStudyBySlug } from '../../data/case-studies';

export function getStaticPaths() {
  return work.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const study = caseStudyBySlug(item.slug);

const others = work.filter((w) => w.slug !== item.slug);

/**
 * The bullet copy uses `backticks` for identifiers. Turn them into real <code>
 * elements. Author-controlled content only — nothing here comes from a visitor.
 */
function code(text: string): string {
  return text.replace(
    /`([^`]+)`/g,
    '<code class="rounded border border-white/8 bg-black/30 px-1 py-0.5 font-mono text-[0.85em] text-ink">$1</code>'
  );
}
---

<Base title={`${item.title} · ${profile.name}`} description={item.summary}>
  <article class="mx-auto max-w-7xl px-4 pt-10 pb-20">
    <a
      href="/#work"
      class="inline-block font-mono text-xs text-ink-muted transition-colors hover:text-signal"
    >
      ← all work
    </a>

    <!-- ================================================================
         Header tile
    ================================================================ -->
    <header class="tile tile-glow mt-4 grid gap-8 p-6 sm:p-9 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="label label-signal">{item.kicker}</p>
        <h1 class="mt-3 text-[length:var(--text-section)] font-bold leading-tight">
          {item.title}
        </h1>
        <p class="mt-5 leading-relaxed text-ink-muted">{study?.scope ?? item.summary}</p>
        <p class="mt-6 flex flex-wrap gap-2">
          {item.tags.map((tag) => <span class="tag">{tag}</span>)}
        </p>
      </div>

      <div class="flex flex-col justify-between gap-6 lg:col-span-5">
        <div>
          <p class="figure text-4xl font-medium">{item.figure}</p>
          <p class="mt-1.5 text-xs leading-snug text-ink-faint">{item.figureNote}</p>
        </div>
        <div class="rounded-xl border border-white/6 bg-black/25 p-4">
          <MiniViz kind={workViz[item.slug]} />
        </div>
      </div>
    </header>

    {item.slug === 'radar-mlops' && (
      <div class="reveal mt-4">
        <RadarDiagram />
      </div>
    )}

    {
      study && (
        <div class="mt-4 grid gap-4 lg:grid-cols-12">
          <!-- ==========================================================
               Body
          ========================================================== -->
          <div class="space-y-4 lg:col-span-8">
            {study.blocks.map((block) => (
              <section class="tile reveal p-6 sm:p-8">
                <h2 class="text-lg font-semibold">{block.heading}</h2>

                {block.body && (
                  <p class="mt-4 leading-relaxed text-ink-muted">{block.body}</p>
                )}

                {block.bullets && (
                  <ul class="mt-5 space-y-3.5">
                    {block.bullets.map((b) => (
                      <li class="flex gap-3">
                        <span
                          class="mt-[0.55rem] size-1 shrink-0 rounded-full bg-signal"
                          aria-hidden="true"
                        />
                        <span class="text-sm leading-relaxed text-ink-muted" set:html={code(b)} />
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}

            <!-- The hard part gets its own emphasis -->
            <section class="tile tile-glow tile-glow-2 reveal p-6 sm:p-8">
              <p class="label label-signal">{study.hardPart.heading}</p>
              <p class="mt-3 text-lg leading-relaxed text-ink">{study.hardPart.body}</p>
            </section>
          </div>

          <!-- ==========================================================
               Sidebar
          ========================================================== -->
          <aside class="space-y-4 lg:col-span-4">
            <div class="tile tile-glow p-6">
              <p class="label label-signal">Measured result</p>
              <dl class="mt-4 space-y-4">
                {study.results.map((r) => (
                  <div>
                    <dt class="figure text-xl font-medium">{r.figure}</dt>
                    <dd class="mt-1 text-xs leading-relaxed text-ink-muted">{r.label}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="tile p-6">
              <p class="label">Stack</p>
              <div class="mt-4 space-y-4">
                {study.stack.map((group) => (
                  <div>
                    <p class="font-mono text-[10px] tracking-wide text-ink-faint uppercase">
                      {group.group}
                    </p>
                    <p class="mt-2 flex flex-wrap gap-1.5">
                      {group.items.map((it) => (
                        <span class="tag">{it}</span>
                      ))}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            {study.caveat && (
              <div class="tile p-6">
                <p class="label" style="color: var(--color-warn)">What this page does not claim</p>
                <p class="mt-2 text-xs leading-relaxed text-ink-muted">{study.caveat}</p>
              </div>
            )}
          </aside>
        </div>
      )
    }

    <!-- ================================================================
         Next
    ================================================================ -->
    <nav class="mt-14" aria-label="Other case studies">
      <p class="label mb-3 px-1">Other work</p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.map((o) => (
            <a href={`/work/${o.slug}`} class="tile tile-interactive tile-glow group p-5">
              <p class="label">{o.kicker}</p>
              <h3 class="mt-1.5 text-sm font-semibold transition-colors group-hover:text-signal">
                {o.title}
              </h3>
              <p class="figure mt-3 text-lg">{o.figure}</p>
            </a>
          ))
        }
      </div>
    </nav>
  </article>
</Base>
